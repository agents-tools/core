+func parseTimezoneOffset(bytes: UnsafeBufferPointer<UInt8>, range: Range<Int>, lineNumber: Int)
+  throws -> (hour: Int, minute: Int, consumedLength: Int)
+{
+  guard range.count >= 2 else {
