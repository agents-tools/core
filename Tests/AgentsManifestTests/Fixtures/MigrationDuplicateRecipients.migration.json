{
  "agents": ["codex", "claude-code", "codex", "codex", "claude-code"],
  "sources": {
    ".": {"local": "./rules"},
    "a~/b": {"local": "./other"},
    "source": {"local": "./inherited"}
  },
  "skills": {
    ".": {
      "select": ["review", "empty", "inherited"],
      "exclude": ["review"],
      "agents": ["opencode", "claude-code", "opencode", "claude-code"],
      "overrides": {
        "review": {"agents": ["cursor", "codex", "cursor", "codex"]},
        "empty": {"agents": []},
        "inherited": {"mode": "copy"},
        "unused": {"agents": ["gemini-cli", "gemini-cli"], "mode": "copy"}
      }
    },
    "a~/b": {
      "select": "all",
      "agents": [],
      "overrides": {
        "future": {"agents": ["opencode", "opencode"]}
      }
    },
    "source": {"select": "all"}
  },
  "instructions": {
    "agents": ["gemini-cli", "codex", "gemini-cli", "codex"],
    "sections": ["guide", ".:rule"]
  },
  "watch": ["."]
}
